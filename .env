# Configuration for the Dockerised Ollama server (read automatically by
# docker compose). Edit these values, then run `docker compose up -d`.

# Host port the API is published on (reachable across the LAN).
OLLAMA_PORT=11444

# Host directory for models and Ollama state (bind-mounted into the
# container). Models are only downloaded once and kept here.
OLLAMA_DATA=./ollama_data

# Default context window length.
OLLAMA_CONTEXT_LENGTH=8192

# How long a model stays loaded in memory after the last request.
OLLAMA_KEEP_ALIVE=5m

# Models to pull automatically on start (space or comma separated).
# Example: OLLAMA_PULL_MODELS=phi4:latest llama3.2:latest
OLLAMA_PULL_MODELS=phi4:latest
